# Order matters: the LAST matching rule wins, so the catch-all goes first.
* text=auto

# Fixtures are signed byte-for-byte: line-ending conversion would break the
# Ed25519 verification because the signature covers the exact bytes.
tests/fixtures/** -text
*.sig -text

# Binary assets must never be touched.
*.png binary
*.ico binary
*.zst binary
*.gz binary
*.zip binary
