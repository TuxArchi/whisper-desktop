{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whisper Desktop",
  "version": "0.1.1",
  "identifier": "com.whisperdesktop.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Whisper Desktop",
        "width": 980,
        "height": 760,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "Transcribe y traduce audio en local",
    "longDescription": "Transcribe y traduce audio y vídeo sin conexión, con detección automática de hardware y configuración del motor Whisper adaptada a tu GPU.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "targets": [
      "deb",
      "rpm"
    ]
  }
}
